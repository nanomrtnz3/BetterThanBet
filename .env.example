# https://sports.bzzoiro.com/register/  → cuenta → API key
BZZOIRO_API_KEY=

# https://dashboard.api-football.com/  (opcional: solo cuotas en directo)
API_FOOTBALL_KEY=

# Cada cuánto se reescribe el XML. La web lo relee sola.
SYNC_EVERY_MINUTES=15

# Goleadores, tarjetas y winrate cambian poco: no se piden en cada ciclo.
STATS_EVERY_HOURS=12

# Tope diario de API-Football (el plan gratis son 100). 0 desactiva esa API.
API_FOOTBALL_DAILY_CAP=40

# Solo en Vercel. El cron lo envía como Authorization: Bearer …
CRON_SECRET=
# Al conectar el Blob, Vercel crea BLOB_STORE_ID. No hace falta BLOB_READ_WRITE_TOKEN.
